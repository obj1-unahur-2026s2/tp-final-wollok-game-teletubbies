import wollok.game.*
import MainTittle.*

/*
Si hay archivos con nombres iguales o parecidos, agreguen "TLTB"
al final para distinguir los que pertenecen a este proyecto de
Teletubbies. Por ejemplo: "Menu_de_inicio_TLTB.png".
*/

program juego {

  game.width(31)
  game.height(19)
  game.cellSize(50)
  game.title("A Happy Place - Teletubbies escape room")

  const opcionJugar = new OpcionesDelMenu(position = game.at(13,11) , image = "./assets/botones/botonJugar.png")
  const opcionOpciones = new OpcionesDelMenu(position = game.at(13,9) , image = "./assets/botones/botonOpciones.png")
  const opcionSalir = new OpcionesDelMenu(position = game.at(13,7) , image = "./assets/botones/botonSalir.png")
  
  game.addVisual(pantallaDeInicio)
  game.addVisual(opcionJugar)
  game.addVisual(opcionOpciones)
  game.addVisual(opcionSalir)
  game.addVisual(botonSeleccionado)
  botonSeleccionado.moverSeleccionado([opcionJugar, opcionOpciones, opcionSalir])

  keyboard.enter().onPressDo({
    game.say(pantallaDeInicio,"Empezaras un lindo juego")
  })

  game.start()
}