import wollok.game.*
import MainTittle.*
import mapa.*
import sonidos.*

/*
Si hay archivos con nombres iguales o parecidos, agreguen "TLTB"
al final para distinguir los que pertenecen a este proyecto de
Teletubbies. Por ejemplo: "Menu_de_inicio_TLTB.png".
*/

program juego {

  game.width(31)
  game.height(19)
  game.cellSize(50)
  game.title("A Happy Place - Teletubbies escape room")

  const musica = game.sound("./assets/musica/leberch-horror-dark-375194.mp3")
  musica.shouldLoop(true)
  game.schedule(500, {musica.play()})
  menuInterfaz.menuinter()
  //gestorSonido.musica()

  game.start()
}