import wollok.game.*
import MainTittle.*
import mapa.*
import sonidos.*
import Timoty.timoty

/*
Si hay archivos con nombres iguales o parecidos, agreguen "TLTB"
al final para distinguir los que pertenecen a este proyecto de
Teletubbies. Por ejemplo: "Menu_de_inicio_TLTB.png".
*/

program juego {

  const musica = game.sound("sonidos/cancion2.mp3")

  game.schedule(500, { musica.play() })
  game.width(31)
  game.height(19)
  game.cellSize(50)
  game.title("A Happy Place - Teletubbies escape room")

  menuInterfaz.menuInicio()


  game.start()
}